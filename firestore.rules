rules_version = '2';

// ============================================================
// 나이테 예약 시스템 Firestore 보안 규칙
// Firebase 콘솔 > Firestore Database > [규칙] 탭에 그대로 붙여넣고 [게시]
//
// - 보기: 누구나
// - 예약 생성: 로그인(익명 포함)한 사용자. 작성자 uid 가 함께 저장됩니다.
// - 수정/삭제: 작성자 본인, 관리자, 또는 공유 링크를 연 기기
// - 예약의 editedBy: 마지막으로 추가·수정한 기기 uid (본인 uid 만 기록 가능)
//
// 공유 링크
//   naite_shares/{shareId}               { ownerUid, key }  만든 사람만 읽기
//   naite_access/{uid}/grants/{shareId}  { key }            링크의 key 가 맞아야 생성
//   예약 문서의 shareId 가 같은 예약들(고정 예약 전 회차)이 한 링크로 묶입니다.
//   팀 링크: share 에 teamName 이 있으면 그 팀의 모든 예약이 한 링크로 묶이고,
//            예약의 teamName 은 share 의 teamName 과 같아야 합니다. (다른 팀 행세 방지)
//
// 기기별 표시 이름
//   naite_users/{uid}  { kakaoNick, name, updatedAt }  본인만 쓰기, 본인·관리자만 읽기
//
// 변경 기록 (관리자 [로그 보기])
//   naite_logs/{id}    { action, uid, col, batch, at, res }  본인 uid·서버 시각으로만 생성, 관리자만 읽기
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ▼ 관리자 UID 목록 — config.js 의 ADMIN_UIDS 와 똑같이 맞춰주세요.
    function adminUids() {
      return ['l6wAZEj3oiXO3h4gX7Osq1jQOHH2'];
    }

    // 예약 컬렉션: 정식 + 베타(테스트용)
    function reservationCollections() {
      return ['naite_reservations', 'naite_reservations_beta'];
    }

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.uid in adminUids();
    }

    // 기존(작성자 정보 없는) 예약은 관리자만 수정할 수 있습니다.
    function isOwner() {
      return signedIn() && resource.data.get('ownerUid', '') == request.auth.uid;
    }

    function validShareId(sid) {
      return sid is string && sid.matches('^sh_[A-Za-z0-9]{20}$');
    }

    function sharePath(sid) {
      return /databases/$(database)/documents/naite_shares/$(sid);
    }

    // 이 공유 링크를 만든 사람 (같은 배치에서 막 만드는 중이어도 인정)
    function ownsShare(sid) {
      return signedIn() && validShareId(sid)
        && getAfter(sharePath(sid)).data.ownerUid == request.auth.uid;
    }

    // 링크를 열어 수정 권한을 받은 기기
    function hasGrant(sid) {
      return signedIn() && validShareId(sid)
        && exists(/databases/$(database)/documents/naite_access/$(request.auth.uid)/grants/$(sid));
    }

    // 현재 예약이 속한 공유 링크의 권한이 있는지
    function canUseShare() {
      return 'shareId' in resource.data
        && (hasGrant(resource.data.shareId) || ownsShare(resource.data.shareId));
    }

    // 팀 링크 예약이면 팀명이 팀 링크의 팀명과 같아야 함 (예약별 링크·링크 없는 예약은 해당 없음)
    function teamNameMatches(d) {
      return !('shareId' in d)
        || getAfter(sharePath(d.shareId)).data.get('teamName', null) == null
        || getAfter(sharePath(d.shareId)).data.teamName == d.teamName;
    }

    // editedBy 는 생략하거나(정식 화면) 본인 uid 만 기록할 수 있음
    function editedByOnCreate() {
      return request.resource.data.get('editedBy', request.auth.uid) == request.auth.uid;
    }

    function editedByOnUpdate() {
      return request.resource.data.get('editedBy', '') == resource.data.get('editedBy', '')
        || request.resource.data.get('editedBy', '') == request.auth.uid;
    }

    function isValidReservation(d) {
      return d.keys().hasAll(['date', 'startTime', 'endTime', 'teamName', 'userName', 'peopleCount', 'purpose'])
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.startTime is string && d.startTime.matches('^[0-9]{2}:[0-9]{2}$')
        && d.endTime is string && d.endTime.matches('^[0-9]{2}:[0-9]{2}$')
        && d.teamName is string && d.teamName.size() > 0 && d.teamName.size() <= 30
        && d.userName is string && d.userName.size() > 0 && d.userName.size() <= 20
        && d.peopleCount is int && d.peopleCount >= 1 && d.peopleCount <= 50
        && d.purpose is string && d.purpose.size() <= 20;
    }

    // shareId 는 한 번 붙으면 바꿀 수 없습니다.
    // 예외: 링크가 없던 기존 예약에 작성자가 자기 링크를 새로 붙이는 경우
    function shareIdUnchangedOrAttached() {
      return request.resource.data.get('shareId', '') == resource.data.get('shareId', '')
        || (!('shareId' in resource.data) && isOwner() && ownsShare(request.resource.data.shareId));
    }

    match /{col}/{docId} {
      allow read: if col in reservationCollections();

      // 생성: 로그인 필수 + 작성자 uid 는 반드시 본인
      //       shareId 를 붙이려면 그 링크를 만들었거나 권한을 받은 기기여야 함
      allow create: if col in reservationCollections()
        && signedIn()
        && isValidReservation(request.resource.data)
        && request.resource.data.ownerUid == request.auth.uid
        && (!('shareId' in request.resource.data)
            || ownsShare(request.resource.data.shareId)
            || hasGrant(request.resource.data.shareId))
        && teamNameMatches(request.resource.data)
        && editedByOnCreate();

      // 수정: 작성자, 관리자, 공유 권한. 작성자 정보는 바꿀 수 없음
      allow update: if col in reservationCollections()
        && (isOwner() || isAdmin() || canUseShare())
        && isValidReservation(request.resource.data)
        && request.resource.data.get('ownerUid', '') == resource.data.get('ownerUid', '')
        && shareIdUnchangedOrAttached()
        && teamNameMatches(request.resource.data)
        && editedByOnUpdate();

      // 삭제: 작성자, 관리자, 공유 권한
      allow delete: if col in reservationCollections()
        && (isOwner() || isAdmin() || canUseShare());
    }

    // 공유 링크 — 만든 사람과 링크를 연 기기만 읽을 수 있고(팀 이름 확인용), 한 번 만들면 바꿀 수 없음
    match /naite_shares/{sid} {
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
            || exists(/databases/$(database)/documents/naite_access/$(request.auth.uid)/grants/$(sid)));
      allow create: if signedIn() && validShareId(sid)
        && request.resource.data.keys().hasOnly(['ownerUid', 'key', 'createdAt', 'teamName'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.key is string
        && request.resource.data.key.matches('^[A-Za-z0-9]{32}$')
        && (!('teamName' in request.resource.data)
            || (request.resource.data.teamName is string
                && request.resource.data.teamName.size() > 0
                && request.resource.data.teamName.size() <= 30));
    }

    // 기기별 표시 이름 — 본인만 쓰고, 본인과 관리자만 읽음 (닉네임은 기기가 스스로 적는 값)
    match /naite_users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['kakaoNick', 'name', 'updatedAt'])
        && request.resource.data.get('kakaoNick', '') is string
        && request.resource.data.get('kakaoNick', '').size() <= 40
        && request.resource.data.get('name', '') is string
        && request.resource.data.get('name', '').size() <= 20;
    }

    // 예약 수정·취소 기록 — 본인 uid 로만 남기고, 서버 시각으로만, 관리자만 읽음. 고치거나 지울 수 없음
    match /naite_logs/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['action', 'uid', 'col', 'batch', 'at', 'res'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.action in ['update', 'delete']
        && request.resource.data.col in reservationCollections()
        && request.resource.data.batch is string && request.resource.data.batch.size() <= 40
        && request.resource.data.at == request.time
        && request.resource.data.res is map
        && request.resource.data.res.keys().hasOnly(['date', 'startTime', 'endTime', 'teamName', 'userName'])
        && request.resource.data.res.keys().hasAll(['date', 'startTime', 'endTime', 'teamName', 'userName'])
        && request.resource.data.res.date is string && request.resource.data.res.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.res.startTime is string && request.resource.data.res.startTime.size() <= 5
        && request.resource.data.res.endTime is string && request.resource.data.res.endTime.size() <= 5
        && request.resource.data.res.teamName is string && request.resource.data.res.teamName.size() <= 30
        && request.resource.data.res.userName is string && request.resource.data.res.userName.size() <= 20;
    }

    // 링크를 연 기기의 수정 권한 — 자기 uid 아래에만, key 가 맞을 때만
    match /naite_access/{uid}/grants/{sid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && validShareId(sid)
        && request.resource.data.keys().hasOnly(['key', 'createdAt'])
        && request.resource.data.key == get(sharePath(sid)).data.key;
    }

    // 나머지 경로는 전부 차단
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
